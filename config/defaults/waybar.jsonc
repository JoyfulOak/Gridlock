{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["custom/network", "sndio", "battery", "clock"],
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "!"
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "on-click": "activate"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 72,
    "rewrite": {
      "": "Gridlock"
    }
  },
  "custom/network": {
    "exec": "gridlock-network-status",
    "return-type": "json",
    "interval": 10,
    "format": "󰤨 {text}",
    "tooltip": true
  },
  "sndio": {
    "format": " {volume}%",
    "format-muted": "󰖁 muted",
    "tooltip": false
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 25,
      "critical": 10
    },
    "tooltip": true
  },
  "clock": {
    "format": "  {:%a %b %d  %H:%M}",
    "tooltip": false
  }
}
